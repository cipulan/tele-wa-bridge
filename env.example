# Telegram Bot Configuration
# Get your bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# Allowed Telegram Chat IDs (comma-separated, optional)
# Leave empty to forward from all chats
# You can get chat IDs by forwarding a message to @userinfobot
ALLOWED_CHAT_IDS=123456789,-987654321,555666777

# WhatsApp API Configuration
# Your WhatsApp API gateway endpoint
WA_API_URL=https://your-whatsapp-api-gateway.com/api/sendText

# Authentication key for WhatsApp API
WA_API_KEY=your_whatsapp_api_key_here

# Target WhatsApp group ID where messages will be forwarded
WA_GROUP_ID=120363025502345678

# Health check endpoint port (used by Docker HEALTHCHECK)
HEALTH_PORT=3000

# healthchecks.io monitoring (optional)
# Ping URL of your check - the container pings it every HEALTHCHECKS_INTERVAL_SEC
HEALTHCHECKS_URL=https://hc-ping.com/your-check-uuid
# Ping interval in seconds (default 60)
HEALTHCHECKS_INTERVAL_SEC=60

# Optional: Node environment
NODE_ENV=production
